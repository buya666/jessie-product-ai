<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JessieProduct.AI - Pro Studio Generator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0b1121; /* Darker Slate */
            color: #e2e8f0;
        }
        .glass-panel {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        }
        .gradient-text {
            background: linear-gradient(135deg, #c084fc 0%, #2dd4bf 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .upload-area {
            background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='16' ry='16' stroke='%23475569FF' stroke-width='2' stroke-dasharray='12%2c 12' stroke-dashoffset='0' stroke-linecap='square'/%3e%3c/svg%3e");
            transition: all 0.3s ease;
        }
        .upload-area:hover, .upload-area.dragover {
            background-color: rgba(45, 212, 191, 0.05);
            border-color: #2dd4bf;
            background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='16' ry='16' stroke='%232DD4BFFF' stroke-width='2' stroke-dasharray='12%2c 12' stroke-dashoffset='0' stroke-linecap='square'/%3e%3c/svg%3e");
        }
        /* Custom Scrollbar */
        .style-grid::-webkit-scrollbar { width: 6px; }
        .style-grid::-webkit-scrollbar-track { background: #1e293b; border-radius: 4px; }
        .style-grid::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
        
        .loader {
            width: 32px;
            height: 32px;
            border: 3px solid #FFF;
            border-bottom-color: #c084fc;
            border-radius: 50%;
            display: inline-block;
            box-sizing: border-box;
            animation: rotation 1s linear infinite;
        }
        @keyframes rotation {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .style-card { transition: all 0.2s; }
        .style-card.active {
            border-color: #c084fc;
            background-color: rgba(192, 132, 252, 0.15);
        }
        /* Image Grid Styles */
        .image-grid-1 { grid-template-columns: 1fr; }
        .image-grid-2 { grid-template-columns: repeat(2, 1fr); }
        .image-grid-3 { grid-template-columns: repeat(2, 1fr); }
        .image-grid-4 { grid-template-columns: repeat(2, 1fr); }
        
        .result-item {
            position: relative;
            overflow: hidden;
            background: #020617;
            border-radius: 0.75rem;
            border: 1px solid rgba(255,255,255,0.1);
            width: 100%;
            /* Aspect ratio handled dynamically via JS/Inline style */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .result-item img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Cover ensures the image fills the aspect ratio */
        }
        
        /* Aspect Ratio Buttons */
        .ar-btn.active {
            background-color: #475569;
            color: white;
            border-color: #c084fc;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-purple-500 selection:text-white">

    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/90 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600 to-teal-500 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-purple-900/20">
                    J
                </div>
                <h1 class="text-xl font-bold tracking-tight text-white">
                    JessieProduct<span class="gradient-text">.AI</span>
                </h1>
            </div>
            <div class="flex items-center gap-4 text-sm text-slate-400">
                <div class="hidden md:flex items-center gap-2 bg-slate-800/50 px-3 py-1 rounded-full border border-slate-700">
                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                    <span>Engine: Jessie.AI V 1.0</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <div class="text-center mb-10">
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight">Studio Fotografi <span class="gradient-text">Multi-View</span></h2>
            <p class="text-slate-400 max-w-2xl mx-auto text-lg leading-relaxed">
                Image Generator Product - Unlimited Akses
                <br><span class="text-slate-500 text-sm font-mono mt-2 inline-block border border-slate-700/50 rounded-full px-3 py-0.5">Versi V1.0</span>
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
            
            <!-- Left Column: Input & Controls (5 columns) -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                <!-- Input Card -->
                <div class="glass-panel rounded-2xl p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-semibold text-white flex items-center gap-2">
                            <i class="fas fa-camera text-purple-400"></i> Upload Produk
                        </h3>
                    </div>

                    <div id="dropzone" class="upload-area h-56 rounded-xl flex flex-col items-center justify-center cursor-pointer relative overflow-hidden group bg-slate-800/30">
                        <!-- Visual Content -->
                        <div id="uploadPrompt" class="text-center p-4 transition-all duration-300 group-hover:scale-105 z-10 flex flex-col items-center">
                            <div class="w-14 h-14 bg-slate-800 rounded-full flex items-center justify-center mb-3 group-hover:bg-slate-700 transition-colors border border-slate-700 shadow-lg">
                                <i class="fas fa-cloud-upload-alt text-2xl text-teal-400"></i>
                            </div>
                            <p class="text-slate-300 text-sm font-semibold">Drop foto produk di sini</p>
                            <span class="text-slate-500 text-[10px] my-2 uppercase tracking-widest">- atau -</span>
                            <div class="bg-slate-700 group-hover:bg-slate-600 border border-slate-600 text-white text-xs font-bold px-5 py-2 rounded-full shadow-md transition-all flex items-center gap-2">
                                <i class="fas fa-folder-open text-teal-400"></i> Pilih File
                            </div>
                        </div>

                        <!-- Actual Input (Overlay on top with z-50 to ensure clickability) -->
                        <input type="file" id="fileInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-50" accept="image/*">
                        
                        <!-- Preview Image -->
                        <img id="previewImage" class="absolute inset-0 w-full h-full object-contain hidden bg-slate-900 p-2 z-40" alt="Preview">
                        
                        <!-- Remove Button -->
                        <button id="removeImageBtn" class="absolute top-2 right-2 bg-red-500 hover:bg-red-600 text-white w-8 h-8 flex items-center justify-center rounded-full hidden transition-colors z-50 shadow-lg text-xs">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <!-- Settings Card -->
                <div class="glass-panel rounded-2xl p-6 flex-grow flex flex-col gap-5">
                    
                    <!-- 1. Mode Studio -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="font-semibold text-white flex items-center gap-2 text-sm">
                                <i class="fas fa-sliders-h text-teal-400"></i> Mode Studio
                            </h3>
                        </div>
                        <div class="grid grid-cols-2 gap-2 max-h-[160px] overflow-y-auto style-grid pr-1" id="styleContainer">
                            <!-- Styles injected via JS -->
                        </div>
                    </div>

                    <hr class="border-slate-700/50">

                    <!-- 2. Dimensi & Ukuran (NEW) -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="font-semibold text-white flex items-center gap-2 text-sm">
                                <i class="fas fa-expand text-blue-400"></i> Dimensi & Ukuran
                            </h3>
                        </div>
                        <div class="grid grid-cols-5 gap-2" id="aspectRatioContainer">
                            <!-- Injected via JS -->
                        </div>
                    </div>

                    <!-- 3. Jumlah Generate & Views -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="font-semibold text-white flex items-center gap-2 text-sm">
                                <i class="fas fa-layer-group text-purple-400"></i> Jumlah & View
                            </h3>
                        </div>
                        
                        <!-- Count Selector -->
                        <div class="flex bg-slate-800/80 p-1 rounded-lg mb-4">
                            <button class="count-btn flex-1 py-2 text-xs font-medium rounded-md transition-all bg-slate-600 text-white shadow-md" onclick="setRenderCount(1)">1 Pic</button>
                            <button class="count-btn flex-1 py-2 text-xs font-medium rounded-md transition-all text-slate-400 hover:text-white" onclick="setRenderCount(2)">2 Pics</button>
                            <button class="count-btn flex-1 py-2 text-xs font-medium rounded-md transition-all text-slate-400 hover:text-white" onclick="setRenderCount(3)">3 Pics</button>
                            <button class="count-btn flex-1 py-2 text-xs font-medium rounded-md transition-all text-slate-400 hover:text-white" onclick="setRenderCount(4)">4 Pics</button>
                        </div>

                        <!-- Dynamic View Selectors -->
                        <div id="viewSelectorsContainer" class="space-y-2">
                            <!-- Injected via JS based on count -->
                        </div>
                    </div>

                    <!-- 4. Prompt -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Detail Tambahan</label>
                        <textarea id="promptInput" rows="2" class="w-full bg-slate-900/80 border border-slate-700 rounded-lg p-3 text-slate-200 focus:ring-2 focus:ring-teal-500 focus:outline-none text-xs resize-none placeholder-slate-600" placeholder="Cth: Pencahayaan sore hari, material kayu..."></textarea>
                    </div>

                    <button id="generateBtn" class="w-full mt-2 bg-gradient-to-r from-purple-600 to-teal-600 hover:from-purple-500 hover:to-teal-500 text-white font-bold py-3 rounded-xl shadow-lg shadow-purple-900/30 transition-all transform hover:scale-[1.01] active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 group">
                        <span class="group-hover:animate-pulse"><i class="fas fa-wand-magic-sparkles"></i></span> 
                        Render Studio (AI)
                    </button>
                </div>
            </div>

            <!-- Right Column: Output Grid (7 columns) -->
            <div class="lg:col-span-7 h-full">
                <div class="glass-panel rounded-2xl p-4 h-full min-h-[600px] flex flex-col relative">
                    
                    <div class="flex justify-between items-center mb-4 px-2">
                        <h3 class="font-semibold text-white">Hasil Render</h3>
                        <span id="statusText" class="text-xs text-slate-400">Siap memproses</span>
                    </div>

                    <!-- Output Grid Container -->
                    <div id="outputGrid" class="grid gap-4 w-full h-fit flex-grow transition-all duration-300 image-grid-1 bg-[#050914] rounded-xl p-4 border border-slate-800/50 overflow-y-auto">
                        
                        <!-- Placeholder State (Default) -->
                        <div id="gridPlaceholder" class="flex flex-col items-center justify-center h-full col-span-full text-slate-600 min-h-[400px]">
                             <div class="w-20 h-20 bg-slate-800/30 rounded-2xl border border-slate-700/50 flex items-center justify-center mb-4">
                                <i class="fas fa-images text-3xl"></i>
                            </div>
                            <p class="text-sm">Hasil render grid akan muncul di sini</p>
                        </div>

                    </div>
                    
                    <!-- Error Toast -->
                    <div id="errorMsg" class="hidden mt-3 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-200 text-xs flex items-start gap-2">
                        <i class="fas fa-exclamation-triangle mt-0.5 text-red-400"></i>
                        <span id="errorText">Terjadi kesalahan.</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-slate-500 text-sm mb-1">Designed for <span class="text-slate-300 font-semibold">JSArchitech & Buya Raya</span></p>
            <p class="text-slate-600 text-xs">&copy; 2025 JessieProduct.AI</p>
        </div>
    </footer>

    <!-- Logic -->
    <script type="module">
        // --- Configuration ---
        const apiKey = ""; 
        const MODEL_NAME = "gemini-2.5-flash-image-preview";

        // --- Data ---
        const styles = [
            { id: 'clean_studio', name: 'Tanpa Model (Clean)', icon: 'fa-cube', prompt: 'Professional product photography, clean studio setting, neutral background, no human presence, focus strictly on the product, high key lighting.' },
            { id: 'with_model', name: 'Dengan Model', icon: 'fa-user-tie', prompt: 'Product lifestyle photography, a professional model interacting with the product, holding or using it naturally, photorealistic skin texture.' },
            { id: 'candid', name: 'Candid / Lifestyle', icon: 'fa-mug-hot', prompt: 'Candid lifestyle photography, product placed in a real-life environment (cafe, office, home), natural lighting, authentic feel.' },
            { id: 'podium', name: 'Luxury Podium', icon: 'fa-layer-group', prompt: 'High-end luxury product photography, premium marble or gold podium, dramatic spotlight, reflection on the floor.' },
            { id: 'nature', name: 'Outdoor / Alam', icon: 'fa-leaf', prompt: 'Outdoor product photography, natural sunlight, surrounded by nature, green leaves, stones, organic atmosphere.' },
            { id: 'industrial', name: 'Industrial', icon: 'fa-city', prompt: 'Industrial style photography, raw concrete textures, harsh geometric shadows, steel accents, warehouse setting.' }
        ];

        const viewOptions = [
            { id: 'front', label: 'Tampak Depan (Front View)', prompt: 'Straight front view eye-level angle, symmetrical composition.' },
            { id: 'low_angle', label: 'Low Angle (Hero Shot)', prompt: 'Low angle shot looking up at the product, making it look grand and imposing (Hero Shot).' },
            { id: 'high_angle', label: 'High Angle', prompt: 'High angle shot looking slightly down at the product, showing the top details.' },
            { id: 'top_down', label: 'Top View (Flat Lay)', prompt: 'Direct top-down view (Flat lay), 90 degree angle.' },
            { id: 'perspective', label: 'Perspektif (3/4 View)', prompt: 'Three-quarter perspective view, showing depth and dimension.' },
            { id: 'pov_hand', label: 'POV - Di Tangan', prompt: 'First-person point of view (POV) shot, a realistic human hand holding the product up in front of the camera, focus strictly on the product, blurred background (bokeh), natural skin texture.' }
        ];

        const aspectRatios = [
            { id: '1:1', label: '1:1', width: 1, height: 1, desc: 'Square' },
            { id: '16:9', label: '16:9', width: 16, height: 9, desc: 'Landscape' },
            { id: '9:16', label: '9:16', width: 9, height: 16, desc: 'Portrait' },
            { id: '4:3', label: '4:3', width: 4, height: 3, desc: 'Photo' },
            { id: '3:4', label: '3:4', width: 3, height: 4, desc: 'Poster' }
        ];

        // --- State ---
        let currentFileBase64 = null;
        let currentMimeType = null;
        let selectedStyleId = 'clean_studio';
        let selectedAspectRatio = '1:1';
        let renderCount = 1;
        
        // --- DOM Elements ---
        const fileInput = document.getElementById('fileInput');
        const dropzone = document.getElementById('dropzone');
        const previewImage = document.getElementById('previewImage');
        const uploadPrompt = document.getElementById('uploadPrompt');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const styleContainer = document.getElementById('styleContainer');
        const aspectRatioContainer = document.getElementById('aspectRatioContainer');
        const viewSelectorsContainer = document.getElementById('viewSelectorsContainer');
        const outputGrid = document.getElementById('outputGrid');
        const gridPlaceholder = document.getElementById('gridPlaceholder');
        const promptInput = document.getElementById('promptInput');
        const generateBtn = document.getElementById('generateBtn');
        const errorMsg = document.getElementById('errorMsg');
        const errorText = document.getElementById('errorText');
        const statusText = document.getElementById('statusText');

        // --- Initialization ---
        function init() {
            renderStyles();
            renderAspectRatios();
            updateViewSelectors();
            window.setRenderCount = setRenderCount; 
            window.setAspectRatio = setAspectRatio;
        }

        // --- Render UI Functions ---

        function renderStyles() {
            styleContainer.innerHTML = '';
            styles.forEach(style => {
                const div = document.createElement('div');
                div.className = `style-card cursor-pointer border border-slate-700 rounded-lg p-2 bg-slate-800/50 hover:bg-slate-700/50 flex items-center gap-2 ${style.id === selectedStyleId ? 'active' : ''}`;
                div.onclick = () => selectStyle(style.id);
                div.innerHTML = `
                    <i class="fas ${style.icon} text-teal-400 text-xs w-4 text-center"></i>
                    <span class="font-bold text-[10px] text-white truncate">${style.name}</span>
                `;
                styleContainer.appendChild(div);
            });
        }

        function renderAspectRatios() {
            aspectRatioContainer.innerHTML = '';
            aspectRatios.forEach(ar => {
                const btn = document.createElement('button');
                btn.className = `ar-btn text-[10px] py-1.5 rounded border border-slate-700 bg-slate-800/50 text-slate-400 hover:text-white transition-all ${ar.id === selectedAspectRatio ? 'active' : ''}`;
                btn.innerHTML = `<b>${ar.label}</b>`;
                btn.onclick = () => setAspectRatio(ar.id);
                aspectRatioContainer.appendChild(btn);
            });
        }

        function selectStyle(id) {
            selectedStyleId = id;
            const cards = styleContainer.querySelectorAll('.style-card');
            cards.forEach((card, index) => {
                if (styles[index].id === id) card.classList.add('active');
                else card.classList.remove('active');
            });
        }

        function setAspectRatio(id) {
            selectedAspectRatio = id;
            const btns = aspectRatioContainer.querySelectorAll('.ar-btn');
            btns.forEach((btn, index) => {
                if (aspectRatios[index].id === id) btn.classList.add('active');
                else btn.classList.remove('active');
            });
            // Don't update grid immediately to avoid jarring shifts before generation
        }

        function setRenderCount(count) {
            renderCount = count;
            const btns = document.querySelectorAll('.count-btn');
            btns.forEach((btn, idx) => {
                if ((idx + 1) === count) {
                    btn.classList.remove('text-slate-400');
                    btn.classList.add('bg-slate-600', 'text-white', 'shadow-md');
                } else {
                    btn.classList.add('text-slate-400');
                    btn.classList.remove('bg-slate-600', 'text-white', 'shadow-md');
                }
            });
            updateViewSelectors();
        }

        function updateViewSelectors() {
            viewSelectorsContainer.innerHTML = '';
            for (let i = 0; i < renderCount; i++) {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex items-center gap-2 bg-slate-800/50 p-2 rounded border border-slate-700/50';
                
                const label = document.createElement('span');
                label.className = 'text-[10px] text-teal-400 font-bold w-12';
                label.innerText = `View ${i + 1}`;

                const select = document.createElement('select');
                select.className = `view-select w-full bg-slate-900 text-xs text-white border border-slate-700 rounded p-1 focus:outline-none focus:border-teal-500`;
                select.dataset.index = i;
                
                viewOptions.forEach((opt, idx) => {
                    const option = document.createElement('option');
                    option.value = opt.id;
                    option.innerText = opt.label;
                    if (i === 0 && idx === 0) option.selected = true; // Front
                    else if (i === 1 && idx === 1) option.selected = true; // Low Angle
                    else if (i === 2 && idx === 3) option.selected = true; // Top
                    else if (i === 3 && idx === 4) option.selected = true; // Perspective
                    select.appendChild(option);
                });

                wrapper.appendChild(label);
                wrapper.appendChild(select);
                viewSelectorsContainer.appendChild(wrapper);
            }
        }

        // --- Logic Functions ---

        function constructPrompt(viewId) {
            const styleObj = styles.find(s => s.id === selectedStyleId);
            const viewObj = viewOptions.find(v => v.id === viewId);
            const arObj = aspectRatios.find(a => a.id === selectedAspectRatio);
            const userText = promptInput.value.trim();
            
            let prompt = `Create a photorealistic product photography based on the input image. `;
            prompt += `${styleObj.prompt} `;
            prompt += `CAMERA ANGLE: ${viewObj.prompt} `;
            prompt += `ASPECT RATIO: ${arObj.label} (${arObj.desc}). `; // Prompting for AR
            prompt += `Use Unreal Engine 5 rendering style, Ray Tracing, 8k resolution, highly detailed textures, physically based rendering (PBR), cinematic lighting. `;
            prompt += `CRITICAL: Keep the main product EXACTLY as it appears in the input image. `;
            
            if (userText) prompt += `Details: ${userText}. `;
            
            return prompt;
        }

        async function generateImage() {
            if (!currentFileBase64) {
                showError("Mohon upload foto produk terlebih dahulu.");
                return;
            }

            // UI Prep
            generateBtn.disabled = true;
            generateBtn.classList.add('opacity-75');
            gridPlaceholder.classList.add('hidden');
            errorMsg.classList.add('hidden');
            statusText.innerText = `Memproses ${renderCount} gambar (${selectedAspectRatio})...`;
            
            // Clear grid and create loading slots with dynamic Aspect Ratio
            outputGrid.innerHTML = '';
            outputGrid.className = `grid gap-4 w-full h-fit flex-grow transition-all duration-300 image-grid-${renderCount} bg-[#050914] rounded-xl p-4 border border-slate-800/50 overflow-y-auto`;
            
            const selectedAR = aspectRatios.find(ar => ar.id === selectedAspectRatio);
            const aspectRatioStyle = `aspect-ratio: ${selectedAR.width}/${selectedAR.height};`;

            const loadingSlots = [];
            const viewSelects = document.querySelectorAll('.view-select');
            const selectedViews = Array.from(viewSelects).map(s => s.value);

            for (let i = 0; i < renderCount; i++) {
                const slot = document.createElement('div');
                slot.className = 'result-item flex flex-col items-center justify-center bg-slate-900 border border-slate-700';
                slot.style.cssText = aspectRatioStyle; // Apply AR dynamically
                slot.id = `slot-${i}`;
                
                const loaderHtml = `
                    <div class="loader mb-2"></div>
                    <span class="text-[10px] text-slate-400 animate-pulse">Rendering View ${i+1}...</span>
                `;
                slot.innerHTML = loaderHtml;
                outputGrid.appendChild(slot);
                loadingSlots.push(slot);
            }

            // Execute Requests
            const promises = selectedViews.map((viewId, index) => {
                const prompt = constructPrompt(viewId);
                return processSingleImage(prompt, index);
            });

            await Promise.all(promises);

            generateBtn.disabled = false;
            generateBtn.classList.remove('opacity-75');
            statusText.innerText = "Proses Selesai";
        }

        async function processSingleImage(prompt, index) {
            const slot = document.getElementById(`slot-${index}`);
            try {
                const imageUrl = await callGeminiAPI(prompt, currentFileBase64, currentMimeType);
                
                slot.innerHTML = `
                    <div class="relative w-full h-full group overflow-hidden">
                        <img src="${imageUrl}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        
                        <!-- View Label -->
                        <div class="absolute bottom-2 left-2 bg-black/60 backdrop-blur px-2 py-1 rounded text-[10px] text-white border border-white/10 pointer-events-none z-10">
                            View ${index + 1}
                        </div>

                        <!-- Download Overlay Button -->
                        <button onclick="downloadSingle('${imageUrl}', ${index})" class="absolute inset-0 z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 bg-black/20 group-hover:bg-black/40 cursor-pointer">
                            <div class="bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/30 text-white rounded-full w-12 h-12 flex items-center justify-center transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 shadow-xl">
                                <i class="fas fa-download text-lg"></i>
                            </div>
                        </button>
                    </div>
                `;
            } catch (error) {
                console.error(`Error slot ${index}:`, error);
                slot.innerHTML = `
                    <div class="p-4 text-center">
                        <i class="fas fa-exclamation-circle text-red-400 text-xl mb-2"></i>
                        <p class="text-[10px] text-red-200">Gagal Render</p>
                        <button class="mt-2 text-[10px] bg-slate-700 px-2 py-1 rounded hover:bg-slate-600" onclick="retrySlot(${index})">Retry</button>
                    </div>
                `;
            }
        }

        async function callGeminiAPI(prompt, base64Image, mimeType) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`;
            const selectedAR = aspectRatios.find(ar => ar.id === selectedAspectRatio);
            
            // Note: Standard 'generateContent' with images usually defaults to 1:1 in preview models. 
            // We pass aspect ratio in prompt, but for models that support config, we'd add it here.
            // For JessieProduct.AI preview, we rely on Prompt + UI Cropping.
            
            const payload = {
                contents: [{
                    parts: [
                        { text: prompt },
                        { inlineData: { mimeType: mimeType, data: base64Image } }
                    ]
                }],
                generationConfig: {
                    responseModalities: ["IMAGE"],
                    temperature: 0.4,
                    // Note: aspectRatio parameter availability depends on specific model version updates.
                    // We include prompt instruction as primary method.
                }
            };

            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error("API Error");
            const data = await response.json();
            const part = data.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
            if (part && part.inlineData) return `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
            throw new Error("No image data");
        }

        // --- Helpers ---
        window.downloadSingle = (url, idx) => {
            const link = document.createElement('a');
            link.href = url;
            link.download = `jessie-view-${idx+1}-${selectedAspectRatio.replace(':','-')}-${Date.now()}.png`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        function showError(msg) {
            errorText.textContent = msg;
            errorMsg.classList.remove('hidden');
            setTimeout(() => errorMsg.classList.add('hidden'), 5000);
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) return showError("Max 5MB");
                const reader = new FileReader();
                reader.onload = (e) => {
                    previewImage.src = e.target.result;
                    previewImage.classList.remove('hidden');
                    uploadPrompt.classList.add('hidden');
                    removeImageBtn.classList.remove('hidden');
                    currentFileBase64 = e.target.result.split(',')[1];
                    currentMimeType = file.type;
                };
                reader.readAsDataURL(file);
            }
        }

        function clearInput() {
            fileInput.value = '';
            previewImage.src = '';
            previewImage.classList.add('hidden');
            uploadPrompt.classList.remove('hidden');
            removeImageBtn.classList.add('hidden');
            currentFileBase64 = null;
        }

        // Listeners
        fileInput.addEventListener('change', handleFileSelect);
        dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
        dropzone.addEventListener('dragleave', () => { dropzone.classList.remove('dragover'); });
        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('dragover');
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                handleFileSelect({ target: fileInput });
            }
        });
        removeImageBtn.addEventListener('click', (e) => { e.stopPropagation(); clearInput(); });
        generateBtn.addEventListener('click', generateImage);

        // Run Init
        init();

    </script>
</body>
</html>
